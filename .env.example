# Example environment variables for local frontend development.
# Copy this file to .env and fill in the values for your environment.

# The base URL for the backend API.
VITE_API_BASE_URL="http://127.0.0.1:8000"
VITE_AUTH_MODE="local"

# Backend-only. Never expose this through VITE_* variables.
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"

# Optional RAG embeddings. Gemini is only required for pgvector indexing/retrieval.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"
RAG_EMBEDDING_DIMENSIONS="768"
RAG_TOP_K="6"
RAG_CHUNK_SIZE="900"
RAG_CHUNK_OVERLAP="120"
EMBEDDING_REQUEST_TIMEOUT_SECONDS="20"

# Backend configuration. For Cloud Run, set ALLOWED_ORIGINS to your Firebase
# Hosting or Cloud CDN frontend URL.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-firebase-project.web.app"

# Local development defaults to SQLite and needs no database server.
INTERNIQ_STORAGE_BACKEND="sqlite"
INTERNIQ_AUTH_MODE="local"
INTERNIQ_SQLITE_PATH="backend/data/interniq.sqlite3"
# Optional public employer career-board sources. Add comma-separated entries.
# Entry format: board-token-or-slug:Employer Name
INTERNSHIP_GREENHOUSE_BOARDS=""
INTERNSHIP_LEVER_BOARDS=""
INTERNSHIP_ASHBY_BOARDS=""

# Optional future deployment settings (set both modes explicitly before use).
# VITE_AUTH_MODE="supabase"
# VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# VITE_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
# VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id"
# INTERNIQ_STORAGE_BACKEND="postgres"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interniq"
# DB_CONNECT_TIMEOUT_SECONDS="10"

# Backend verifies Supabase access tokens and protects scraper/reindex operations.
# Supabase API token verification for the future hosted auth mode.
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
INTERNIQ_ADMIN_TOKEN="generate-a-long-random-token"
