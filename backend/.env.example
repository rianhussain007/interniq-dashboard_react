# Example environment variables for the backend.
# Copy this file to ../.env for local development, or configure these values
# in Secret Manager / Cloud Run for GCP deployment.

ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-firebase-project.web.app"
GROQ_API_KEY="your-groq-api-key"
GROQ_MODEL="openai/gpt-oss-20b"

# RAG embeddings. Gemini API uses this key for pgvector indexing/retrieval.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"
RAG_EMBEDDING_DIMENSIONS="768"
RAG_TOP_K="6"
RAG_CHUNK_SIZE="900"
RAG_CHUNK_OVERLAP="120"
EMBEDDING_REQUEST_TIMEOUT_SECONDS="20"

# Local development uses SQLite without an external database process.
INTERNIQ_STORAGE_BACKEND="sqlite"
INTERNIQ_AUTH_MODE="local"
INTERNIQ_SQLITE_PATH="backend/data/interniq.sqlite3"
INTERNSHIP_GREENHOUSE_BOARDS=""
INTERNSHIP_LEVER_BOARDS=""
INTERNSHIP_ASHBY_BOARDS=""

# Optional PostgreSQL for staging/production; set INTERNIQ_STORAGE_BACKEND=postgres.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interniq"
DB_CONNECT_TIMEOUT_SECONDS="10"

# Out-of-app alert email. Alerts stay in-app until both a key and sender exist.
# RESEND_API_KEY="re_your_resend_api_key"
# INTERNIQ_EMAIL_FROM="InternIQ <alerts@your-verified-domain.example>"
# INTERNIQ_APP_URL="http://localhost:5173"
# Development only: write messages to a file instead of contacting the provider.
# INTERNIQ_EMAIL_TRANSPORT="log"
# INTERNIQ_EMAIL_LOG="data/email_outbox.jsonl" (relative to the backend process directory)
# Server-side alert generation so email arrives while the app is closed.
# INTERNIQ_ALERT_SCHEDULER="auto"
# INTERNIQ_ALERT_SCHEDULER_INTERVAL_SECONDS="300"
# Signs one-click unsubscribe links (defaults to INTERNIQ_ADMIN_TOKEN).
# INTERNIQ_UNSUBSCRIBE_SECRET=""
# Public API base URL for links inside emails, e.g. https://api.example.com
# INTERNIQ_API_PUBLIC_URL=""
# Transient email failures (timeouts, 429, 5xx) retry with exponential backoff;
# messages that never send are appended to the dead-letter file for review.
# INTERNIQ_EMAIL_MAX_ATTEMPTS="3"
# INTERNIQ_EMAIL_BACKOFF_SECONDS="0.75"
# INTERNIQ_EMAIL_DEAD_LETTER="data/email_dead_letter.jsonl"

# Supabase Auth verification for a future hosted mode.
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
INTERNIQ_ADMIN_TOKEN="generate-a-long-random-token"
